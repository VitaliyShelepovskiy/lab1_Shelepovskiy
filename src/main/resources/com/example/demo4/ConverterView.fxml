<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="302.0" prefWidth="273.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo4.ConverterController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="25.0" prefWidth="234.0">
      <children>
         <Label text="Введите число:">
            <font>
               <Font size="14.0" />
            </font>
         </Label>
         <TextField fx:id="input_f" prefHeight="30.0" prefWidth="118.0">
            <font>
               <Font size="14.0" />
            </font>
            <HBox.margin>
               <Insets left="10.0" top="-5.0" />
            </HBox.margin>
         </TextField>
      </children>
   </HBox>
   <HBox prefHeight="27.0" prefWidth="116.0">
      <children>
         <Label prefHeight="23.0" prefWidth="26.0" text="Из">
            <font>
               <Font size="14.0" />
            </font>
         </Label>
         <ComboBox fx:id="cmb" prefHeight="26.0" prefWidth="85.0" />
      </children>
   </HBox>
   <HBox prefHeight="30.0" prefWidth="234.0">
      <children>
         <Label prefHeight="20.0" prefWidth="38.0" text="ASCII:">
            <font>
               <Font size="14.0" />
            </font>
         </Label>
         <TextField fx:id="ascii_f" prefHeight="30.0" prefWidth="177.0">
            <font>
               <Font size="14.0" />
            </font>
            <HBox.margin>
               <Insets left="10.0" top="-5.0" />
            </HBox.margin>
         </TextField>
      </children>
   </HBox>
   <HBox prefHeight="25.0" prefWidth="234.0">
      <children>
         <Label text="Бинарный вид:">
            <font>
               <Font size="14.0" />
            </font>
         </Label>
         <TextField fx:id="binary_f" prefHeight="26.0" prefWidth="120.0">
            <font>
               <Font size="14.0" />
            </font>
            <HBox.margin>
               <Insets left="10.0" top="-5.0" />
            </HBox.margin>
         </TextField>
      </children>
   </HBox>
   <Button mnemonicParsing="false" onAction="#Conv" prefHeight="30.0" prefWidth="110.0" text="Выполнить">
      <VBox.margin>
         <Insets left="60.0" />
      </VBox.margin>
      <font>
         <Font size="14.0" />
      </font>
   </Button>
   <Label fx:id="error_lbl" prefHeight="28.0" prefWidth="237.0">
      <font>
         <Font size="19.0" />
      </font>
   </Label>


</VBox>
